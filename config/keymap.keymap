#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };

        brackets {
            bindings = <&brackets>;
            key-positions = <22 21>;
        };

        quotations {
            bindings = <&quotations>;
            key-positions = <36 35>;
        };
    };

    macros {
        brackets: brackets {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp RIGHT_ARROW &kp RIGHT_BRACKET>;
            label = "BRACKETS";
        };

        quotations: quotations {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp RIGHT_ARROW &kp SQT>;
            label = "QUOTATIONS";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&none  &none           &none     &none     &none  &none                                          &none      &none  &none      &none    &none                 &none
&none  &mt ESCAPE Q    &kp W     &kp E     &kp R  &kp T                                          &kp Y      &kp U  &kp I      &kp O    &kp P                 &none
&none  &mt CAPSLOCK A  &kp S     &kp D     &kp F  &kp G      &none             &none             &kp H      &kp J  &kp K      &kp L    &kp SEMI              &none
&none  &mt LSHFT Z     &kp X     &kp C     &kp V  &kp B      &lt 2 LANGUAGE_1  &lt 3 LANGUAGE_2  &kp N      &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT FSLH  &none
&none  &kp LCTRL       &kp LGUI  &kp LALT  &mo 1  &kp SPACE  &kp TAB           &kp BACKSPACE     &kp ENTER  &none  &none      &mo 4    &kp RCTRL             &none
            >;

            label = "base_layer";
        };

        layer_1 {
            bindings = <
&none  &none  &none      &none           &none      &none                &none  &none      &none           &none      &none  &none
&none  &none  &none      &msc SCRL_UP    &none      &none                &none  &none      &msc SCRL_UP    &none      &none  &none
&none  &none  &mkp RCLK  &mkp MCLK       &mkp LCLK  &none  &none  &none  &none  &mkp LCLK  &mkp MCLK       &mkp RCLK  &none  &none
&none  &none  &none      &msc SCRL_DOWN  &none      &none  &none  &none  &none  &none      &msc SCRL_DOWN  &none      &none  &none
&none  &none  &none      &none           &none      &none  &none  &none  &none  &none      &none           &none      &none  &none
            >;

            label = "mouse_layer";
        };

        layer_2 {
            bindings = <
&none  &none           &none           &none           &none            &none                             &none         &none   &none   &none         &none            &none
&none  &kp TAB         &none           &kp UP_ARROW    &none            &kp PAGE_UP                       &kp N7        &kp N8  &kp N9  &kp MINUS     &kp KP_DIVIDE    &none
&none  &kp CAPS        &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp PAGE_DOWN  &none  &none       &kp N4        &kp N5  &kp N6  &kp PLUS      &kp KP_MULTIPLY  &none
&none  &kp LEFT_SHIFT  &none           &none           &none            &none          &none  &kp N0      &kp N1        &kp N2  &kp N3  &kp ASTERISK  &kp CARET        &none
&none  &none           &none           &none           &none            &none          &none  &kp DELETE  &kp KP_ENTER  &none   &none   &kp KP_EQUAL  &none            &none
            >;

            label = "keypad_layer";
        };

        layer_3 {
            bindings = <
&trans  &trans   &trans   &trans        &trans        &trans                      &trans            &trans     &trans         &trans     &trans      &trans
&trans  &kp F1   &kp F2   &kp F3        &kp F4        &kp F5                      &kp HOME          &kp PG_UP  &kp PAGE_DOWN  &kp END    &kp ESCAPE  &trans
&trans  &kp F6   &kp F7   &kp F8        &kp F9        &kp F10     &trans  &trans  &kp LEFT          &kp DOWN   &kp UP_ARROW   &kp RIGHT  &kp TAB     &trans
&trans  &kp F11  &kp F12  &out OUT_USB  &out OUT_BLE  &bt BT_NXT  &trans  &trans  &kp SINGLE_QUOTE  &kp DQT    &kp GRAVE      &kp TILDE  &kp PIPE    &trans
&trans  &trans   &trans   &trans        &kp DELETE    &kp TAB     &trans  &trans  &trans            &trans     &trans         &trans     &trans      &trans
            >;
        };

        layer_4 {
            bindings = <
&none  &none        &none  &none               &none              &none                     &none          &none          &none          &none          &none          &none
&none  &bootloader  &none  &kp C_FAST_FORWARD  &kp C_VOLUME_UP    &none                     &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4   &none
&none  &none        &none  &kp C_PLAY_PAUSE    &kt C_MUTE         &none  &none  &none       &none          &none          &none          &none          &none          &none
&none  &none        &none  &kp C_RW            &kp C_VOLUME_DOWN  &none  &none  &none       &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4  &none
&none  &none        &none  &none               &none              &none  &none  &bt BT_CLR  &none          &none          &none          &none          &none          &none
            >;

            label = "device_control";
        };
    };
};
